circuit liq_check(
    secret position_size: u64,
    secret entry_price: u64,
    secret leverage: u8,
    public current_price: u64,
    public maintenance_margin_bps: u64,
) -> (public is_liquidatable: bool) {

    let notional = position_size * current_price;
    let initial_margin = position_size * entry_price / (leverage as u64);
    let maintenance_margin = initial_margin * maintenance_margin_bps / 10000;

    let loss = if current_price < entry_price {
        (entry_price - current_price) * position_size
    } else {
        0u64
    };

    is_liquidatable = loss > (initial_margin - maintenance_margin);
}
